#!/bin/sh

set -e

echo "Running pre-commit checks..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

#
# Python — Ruff
#

PYTHON_FILES=$(printf "%s\n" "$STAGED_FILES" | grep '\.py$' || true)

if [ -n "$PYTHON_FILES" ]; then
  if ! python -m ruff --version >/dev/null 2>&1; then
    echo "Ruff is not installed."
    echo "Run: python -m pip install -r requirements-dev.txt"
    exit 1
  fi

  printf "%s\n" "$PYTHON_FILES" | while IFS= read -r file; do
    echo "Linting $file"
    python -m ruff check --fix "$file"

    echo "Formatting $file"
    python -m ruff format "$file"

    git add "$file"
  done
fi

#
# Frontend — ESLint + Prettier
#

FRONTEND_FILES=$(printf "%s\n" "$STAGED_FILES" | grep '^frontend/' || true)

if [ -n "$FRONTEND_FILES" ]; then
  if [ ! -d frontend/node_modules ]; then
    echo "Installing frontend dependencies..."
    npm --prefix frontend ci
  fi

  printf "%s\n" "$FRONTEND_FILES" | while IFS= read -r file; do
    relative="${file#frontend/}"

    case "$file" in
      *.js|*.mjs|*.cjs|*.jsx|*.ts|*.mts|*.cts|*.tsx|*.vue)
        echo "Linting $file"
        (
          cd frontend
          npx --no-install eslint --fix "$relative"
        )
        ;;
    esac

    case "$file" in
      *.js|*.mjs|*.cjs|*.jsx|*.ts|*.mts|*.cts|*.tsx|*.vue|*.json|*.css|*.scss|*.md|*.yaml|*.yml)
        echo "Formatting $file"
        (
          cd frontend
          npx --no-install prettier --write "$relative"
        )
        git add "$file"
        ;;
    esac
  done
fi

#
# Documentation — Prettier
#

DOCS_FILES=$(printf "%s\n" "$STAGED_FILES" | grep '^docs/' || true)

if [ -n "$DOCS_FILES" ]; then
  if [ ! -d docs/node_modules ]; then
    echo "Installing documentation dependencies..."
    npm --prefix docs ci
  fi

  printf "%s\n" "$DOCS_FILES" | while IFS= read -r file; do
    relative="${file#docs/}"

    case "$file" in
      *.js|*.mjs|*.cjs|*.jsx|*.ts|*.mts|*.cts|*.tsx|*.vue|*.json|*.css|*.scss|*.md|*.yaml|*.yml)
        echo "Formatting $file"
        (
          cd docs
          npx --no-install prettier --write "$relative"
        )
        git add "$file"
        ;;
    esac
  done
fi

echo "Pre-commit checks complete."